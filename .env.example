# ---------------------------------------------------------------------------
# CognoDB Cloud connection
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values from the CognoDB console.
# The password is shown exactly once when the instance is created.
#
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# Bolt URI from the CognoDB console, e.g. bolt+s://abc123.databases.cognodb.cloud
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud

# Username is always "cognodb" on CognoDB Cloud
COGNODB_USER=cognodb

# Password generated when the instance was provisioned
COGNODB_PASSWORD=

# Optional: database name. CognoDB Cloud uses the default database.
# COGNODB_DATABASE=neo4j

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
PORT=8080
NODE_ENV=development

# Comma-separated origins allowed to call the API in development.
# In production the API and the UI are served from the same origin.
CORS_ORIGINS=http://localhost:5173

# Seconds to cache the (expensive) single-point-of-failure audit
SPOF_CACHE_TTL_SECONDS=300
